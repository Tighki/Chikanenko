# Куда браузер отправляет запросы. Без слэша в конце.
# Это внешний адрес бэка: тот же host, который открыт пробросом порта 4000.
# Пустое значение — режим одного компьютера: Vite проксирует /api на 127.0.0.1:4000.
VITE_API_URL=http://SERVER:4000

# 0.0.0.0 — принимать подключения из сети. 127.0.0.1 снаружи недоступен.
VITE_HOST=0.0.0.0
VITE_PORT=5173
